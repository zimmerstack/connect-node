{
  "name": "@zimmerstack/connect",
  "version": "0.9.0",
  "description": "Add a channel manager to your hotel software: send rooms and prices to Booking.com, Airbnb, Expedia and other booking sites, and receive their bookings. The official ZimmerStack Connect API client for Node.js, with safe retries and pacing built in and an MCP server for AI coding agents.",
  "license": "MIT",
  "homepage": "https://docs.zimmerstack.com/sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zimmerstack/connect-node.git"
  },
  "bugs": {
    "url": "https://github.com/zimmerstack/connect-node/issues",
    "email": "support@zimmerstack.com"
  },
  "keywords": [
    "zimmerstack",
    "channel-manager",
    "channel-manager-api",
    "hotel",
    "vacation-rental",
    "pms",
    "property-management",
    "ota",
    "booking.com",
    "airbnb",
    "expedia",
    "rates",
    "availability",
    "webhooks",
    "sdk",
    "typescript",
    "mcp",
    "model-context-protocol",
    "ai-agents"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "zimmerstack-connect": "./dist/esm/mcp/cli.js"
  },
  "files": [
    "dist",
    "AGENTS.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
